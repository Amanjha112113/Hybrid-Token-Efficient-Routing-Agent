# Fireworks AI API Credentials
# Replace with your actual credentials for local development
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Allowed Models Config
# List the models allowed in order from cheapest (index 0) to most expensive
ALLOWED_MODELS=accounts/fireworks/models/llama-v3p1-8b-instruct,accounts/fireworks/models/deepseek-v4-pro

# Logging Config
LOG_LEVEL=INFO

# Local Model Configurations (Ollama primary with GGUF fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
USE_OLLAMA=true
LOCAL_MODEL_PATH=/app/models/local_model.gguf
LOCAL_LLM_N_CTX=2048

# ── Phase 1: Database Configuration ──────────────────────────────────────────
# SQLite (default — zero config, great for local dev):
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# PostgreSQL (for production — uncomment and set credentials):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gateway

# Enable SQLAlchemy query echo (debug only):
DB_ECHO=false

# PostgreSQL connection pool size (ignored for SQLite):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
